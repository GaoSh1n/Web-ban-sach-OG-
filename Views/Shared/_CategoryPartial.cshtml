@model IEnumerable<Web_Ban_Sach.Models.Category>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-primary text-white font-weight-bold">
        <i class="fas fa-bars mr-1"></i> Danh Mục Sách
    </div>
    <div class="list-group list-group-flush">
        <a href="@Url.Action("Index", "Home")" class="list-group-item list-group-item-action">
            Tất cả sách
        </a>
        @foreach (var item in Model)
        {
            <a href="@Url.Action("Index", "Home", new { categoryId = item.MaTheLoai })" 
               class="list-group-item list-group-item-action">
                @item.TenTheLoai
            </a>
        }
    </div>
</div>