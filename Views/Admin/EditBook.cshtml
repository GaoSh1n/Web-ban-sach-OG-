
@model Web_Ban_Sach.Models.Book
@{
    ViewBag.Title = "Chỉnh Sửa Thông Tin Sách";
    Layout = "~/Views/Shared/_PaymentLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-md-10">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white py-3">
                <h5 class="mb-0 font-weight-bold">
                    <i class="fas fa-edit mr-2"></i>Chỉnh Sửa Sách #@Model.MaSach
                </h5>
            </div>
            <div class="card-body p-4 bg-white">
                @using (Html.BeginForm("EditBook", "Admin", FormMethod.Post))
                {
                    <!-- Giữ lại khóa chính MaSach để cập nhật đúng cuốn sách -->
                    @Html.HiddenFor(m => m.MaSach)

                    <div class="row">
                        <!-- Tên sách -->
                        <div class="col-md-6 form-group">
                            <label class="font-weight-bold">Tên sách <span class="text-danger">*</span></label>
                            @Html.TextBoxFor(m => m.TenSach, new { @class = "form-control", @required = "required" })
                        </div>

                        <!-- Tác giả -->
                        <div class="col-md-6 form-group">
                            <label class="font-weight-bold">Tác giả <span class="text-danger">*</span></label>
                            @Html.DropDownList("MaTacGia", null, new { @class = "form-control", @required = "required" })
                        </div>

                        <!-- Thể loại -->
                        <div class="col-md-4 form-group">
                            <label class="font-weight-bold">Thể loại <span class="text-danger">*</span></label>
                            @Html.DropDownList("MaTheLoai", null, new { @class = "form-control", @required = "required" })
                        </div>

                        <!-- Giá bán -->
                        <div class="col-md-4 form-group">
                            <label class="font-weight-bold">Giá bán (VNĐ) <span class="text-danger">*</span></label>
                            @Html.TextBoxFor(m => m.GiaBan, new { @class = "form-control", @type = "number", @min = "0", @required = "required" })
                        </div>

                        <!-- Số lượng tồn kho -->
                        <div class="col-md-4 form-group">
                            <label class="font-weight-bold">Số lượng tồn kho <span class="text-danger">*</span></label>
                            @Html.TextBoxFor(m => m.SoLuongTon, new { @class = "form-control", @type = "number", @min = "0", @required = "required" })
                        </div>

                        <!-- Hình ảnh -->
                        <div class="col-md-12 form-group">
                            <label class="font-weight-bold">Hình ảnh bìa (Tên file hoặc Link ảnh)</label>
                            @Html.TextBoxFor(m => m.HinhAnh, new { @class = "form-control" })
                        </div>

                        <!-- Mô tả -->
                        <div class="col-md-12 form-group mb-4">
                            <label class="font-weight-bold">Mô tả nội dung</label>
                            @Html.TextAreaFor(m => m.MoTa, new { @class = "form-control", @rows = "4" })
                        </div>
                    </div>

                    <div class="d-flex justify-content-end border-top pt-3">
                        <a href="@Url.Action("Books", "Admin")" class="btn btn-secondary mr-2 px-4">
                            <i class="fas fa-arrow-left mr-1"></i> Quay lại
                        </a>
                        <button type="submit" class="btn btn-primary font-weight-bold px-4">
                            <i class="fas fa-check mr-1"></i> Cập Nhật Thay Đổi
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
