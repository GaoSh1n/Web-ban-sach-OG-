@{
    ViewBag.Title = "Đăng Nhập";
    Layout = "~/Views/Shared/_MyLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-0 my-4">
            <div class="card-header bg-dark text-white text-center py-3">
                <h4 class="font-weight-bold mb-0"><i class="fas fa-sign-in-alt mr-2"></i>Đăng Nhập Khách Hàng</h4>
            </div>
            <div class="card-body p-4">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success" role="alert">
                        <i class="fas fa-check-circle mr-1"></i> @TempData["SuccessMessage"]
                    </div>
                }

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger" role="alert">
                        <i class="fas fa-exclamation-circle mr-1"></i> @ViewBag.Error
                    </div>
                }

                @using (Html.BeginForm("Login", "Account", FormMethod.Post))
                {
                    <div class="form-group">
                        <label class="font-weight-bold">Tài khoản</label>
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text"><i class="fas fa-user"></i></span>
                            </div>
                            <input type="text" name="TaiKhoan" class="form-control" placeholder="Tên tài khoản" required autofocus />
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="font-weight-bold">Mật khẩu</label>
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text"><i class="fas fa-lock"></i></span>
                            </div>
                            <input type="password" name="MatKhau" class="form-control" placeholder="Mật khẩu" required />
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary btn-block font-weight-bold py-2 mt-4 shadow-sm">
                        <i class="fas fa-arrow-right mr-1"></i> Đăng Nhập
                    </button>
                }
            </div>
            <div class="card-footer bg-light text-center py-3">
                <span class="text-muted mb-2">Chưa có tài khoản? </span>
                <a href="@Url.Action("Register", "Account")" class="font-weight-bold text-primary">Đăng ký ngay</a>
            </div>
        </div>
    </div>
</div>