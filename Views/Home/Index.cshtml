@model IEnumerable<Web_Ban_Sach.Models.Book>

@{
    ViewBag.Title = "Trang Chủ";
    Layout = "~/Views/Shared/_MyLayout.cshtml"; // Hoặc _Layout.cshtml tùy file layout bạn đang dùng
}

<!-- Tiêu đề đầu trang -->
<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <h4 class="font-weight-bold text-dark m-0">
        <i class="fas fa-book-open text-primary mr-2"></i>
        @(ViewBag.CategoryTitle ?? "Danh Sách Sách Mới")
    </h4>
    <span class="badge badge-secondary py-2 px-3">Tổng: @Model.Count() cuốn</span>
</div>

<!-- Kiểm tra nếu database chưa có sách -->
@if (!Model.Any())
{
    <div class="alert alert-info text-center py-5 shadow-sm">
        <i class="fas fa-box-open fa-3x mb-3 text-muted"></i>
        <h5>Hiện chưa có cuốn sách nào được bày bán.</h5>
        <p class="text-muted mb-0">Dữ liệu sách sẽ xuất hiện tại đây sau khi được thêm vào cơ sở dữ liệu.</p>
    </div>
}
else
{
    <!-- Lưới hiển thị sản phẩm (Mỗi hàng 3 cuốn sách trên màn hình máy tính) -->
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-lg-4 col-md-6 mb-4">
                <div class="card h-100 shadow-sm border-0" style="transition: transform 0.2s; border-radius: 8px; overflow: hidden;">

                    <!-- Khung ảnh sách -->
                    <div class="bg-light text-center p-3" style="height: 220px; display: flex; align-items: center; justify-content: center;">
                        @if (!string.IsNullOrEmpty(item.HinhAnh))
                        {
                            <img src="~/Images/@item.HinhAnh" alt="@item.TenSach" class="img-fluid" style="max-height: 100%; object-fit: contain;" />
                        }
                        else
                        {
                            <div class="text-muted">
                                <i class="fas fa-book fa-3x text-secondary"></i>
                                <div class="small mt-2">Chưa có ảnh bìa</div>
                            </div>
                        }
                    </div>

                    <!-- Thông tin sách -->
                    <div class="card-body d-flex flex-column">
                        <small class="text-muted mb-1">
                            <i class="fas fa-user-edit mr-1"></i>@(item.Author != null ? item.Author.TenTacGia : "Đang cập nhật")
                        </small>

                        <h6 class="card-title font-weight-bold mb-2" title="@item.TenSach" style="height: 40px; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">
                            @item.TenSach
                        </h6>

                        <div class="mt-auto">
                            <!-- Giá bán -->
                            <div class="text-danger font-weight-bold mb-3" style="font-size: 1.2rem;">
                                @string.Format("{0:N0} đ", item.GiaBan)
                            </div>

                            <!-- Nút chức năng -->
                            <div class="btn-group w-100">
                                <a href="@Url.Action("Details", "Book", new { id = item.MaSach })" class="btn btn-outline-secondary btn-sm">
                                    <i class="fas fa-info-circle mr-1"></i> Chi tiết
                                </a>
                                <a href="@Url.Action("AddToCart", "Cart", new { id = item.MaSach })" class="btn btn-primary btn-sm">
                                    <i class="fas fa-cart-plus mr-1"></i> Mua ngay
                                </a>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        }
    </div>
}